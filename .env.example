# Copier ce fichier en .env et remplir les valeurs : cp .env.example .env
# .env est dans .gitignore — ne jamais le commiter.
# Ces valeurs ne servent qu'au bootstrap : vault-init les écrit dans Vault,
# puis le backend les relit depuis Vault (jamais depuis son environnement).

# → secret/database
POSTGRES_DB=appdb
POSTGRES_USER=app_user
POSTGRES_PASSWORD=          # ex. : openssl rand -base64 24

# → secret/app
NEXTAUTH_SECRET=            # clé de signature JWT — ex. : openssl rand -base64 32
NEXTAUTH_URL=https://localhost:8443

# OAuth GitHub (facultatif — le login email/mot de passe fonctionne sans)
# Callback à déclarer dans l'OAuth App : https://localhost:8443/api/auth/github/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
